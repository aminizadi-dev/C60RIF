@model int
@inject IPictureService pictureService
@inject MediaSettings mediaSettings

@using Nop.Core.Domain.Media
@using Nop.Services.Media

@{
    // Identifiers
    var random = CommonHelper.GenerateRandomInteger();
    var clientId = $"picture{random}";
    var elementId = $"{clientId}element";
    var imageId = $"{clientId}image";
    
    // Constants
    const int pictureSize = 100;

    var allowedMimeTypes = new List<string> { MimeTypes.ImagePng, MimeTypes.ImageBmp, MimeTypes.ImageGif, MimeTypes.ImageJpeg, MimeTypes.ImagePJpeg, MimeTypes.ImageTiff, MimeTypes.ImageWebp };
    if (mediaSettings.AllowSvgUploads)
        allowedMimeTypes.Add(MimeTypes.ImageSvg);

    var picture = await pictureService.GetPictureByIdAsync(Model);
    var files = new List<object>();
    var fullSizePictureUrl = string.Empty;
    var uploadUrl = ViewData["PictureUploadUrl"] as string ?? Url.Content("~/Admin/Picture/AsyncUpload");

    if (picture != null)
    {
        var pictureSource = $"{picture.SeoFilename}.{await pictureService.GetFileExtensionFromMimeTypeAsync(picture.MimeType)}";
        fullSizePictureUrl = await pictureService.GetPictureUrlAsync(Model, targetSize: 0, showDefaultPicture: false);
        files.Add(new
        {
            source = pictureSource,
            options = new
            {
                type = "local",
                file = new
                {
                    name = pictureSource,
                    size = (await pictureService.GetPictureBinaryByPictureIdAsync(picture.Id))?.BinaryData?.Length,
                    type = picture.MimeType
                },
                metadata = new
                {
                    url = await pictureService.GetPictureUrlAsync(Model, showDefaultPicture: false)
                }
            },
        });
    }
}

<noscript>
    <p>Please enable JavaScript to use file uploader.</p>
</noscript>
<input type="hidden" asp-for="@Model"/>

<div id="@(elementId)" class="filepond"></div>
<div class="upload-picture-block">
    <div class="picture-container">
        <div class="uploaded-image">
            @if (picture != null && !string.IsNullOrEmpty(fullSizePictureUrl))
            {
                <a id="@(clientId)link" href="@fullSizePictureUrl" target="_blank" title="@T("Common.ViewFullSize")" style="cursor: pointer;">
                    <img id="@(imageId)" src="@await pictureService.GetPictureUrlAsync(Model, pictureSize)" width="@(pictureSize)" style="cursor: pointer;" />
                </a>
            }
            else
            {
                <img id="@(imageId)" src="@await pictureService.GetPictureUrlAsync(Model, pictureSize)" width="@(pictureSize)" />
            }
        </div>
    </div>
</div>

@* register CSS and JS *@
<link rel="stylesheet" href="~/lib_npm/filepond/filepond.min.css"/>
<link rel="stylesheet" href="~/lib_npm/filepond-plugin-get-file/filepond-plugin-get-file.min.css"/>
<script asp-exclude-from-bundle="true" src="~/lib_npm/filepond/filepond.min.js" asp-location="Footer"></script>
<script asp-exclude-from-bundle="true"
        src="~/lib_npm/filepond-plugin-file-validate-type/filepond-plugin-file-validate-type.min.js"
        asp-location="Footer"></script>
<script asp-exclude-from-bundle="true" src="~/lib_npm/filepond-plugin-get-file/filepond-plugin-get-file.min.js"
        asp-location="Footer"></script>

<script asp-location="Footer">

    $(async function () {

        // Register the plugins
        FilePond.registerPlugin(FilePondPluginFileValidateType, FilePondPluginGetFile);
        const allowedExtensions = @Html.Raw(Json.Serialize(allowedMimeTypes));
        
        const $modelEl = $('#@Html.IdForModel()');
        const $imageEl = $('#@imageId');
        const $imageLink = $('#@(clientId)link');
        const $removeEl = $('#@clientId');
        const uploadUrl = '@uploadUrl';

        function resetImageToDefault() {
            $modelEl.val('0');
            $imageEl.attr("src", '@await pictureService.GetDefaultPictureUrlAsync(pictureSize)');
            // Remove link if exists
            if ($imageLink.length > 0) {
                $imageEl.unwrap();
            }
        }

        // Mirrors MediaSettings so the browser never uploads more pixels than the server keeps.
        const maxImageSize = @mediaSettings.MaximumImageSize;
        const imageQuality = @mediaSettings.DefaultImageQuality / 100;
        const resizableTypes = ['image/jpeg', 'image/pjpeg', 'image/png'];

        // Camera photos are several megabytes, which is painfully slow to upload on a mobile
        // connection, while the server downscales them to maxImageSize anyway. Any failure here
        // falls back to the original file, so the server side behaviour stays unchanged.
        async function downscaleBeforeUpload(file) {
            if (!resizableTypes.includes(file.type) || typeof createImageBitmap !== 'function')
                return file;

            let bitmap;
            try {
                bitmap = await createImageBitmap(file, { imageOrientation: 'from-image' });
            } catch {
                return file;
            }

            try {
                const scale = maxImageSize / Math.max(bitmap.width, bitmap.height);
                if (scale >= 1)
                    return file;

                const canvas = document.createElement('canvas');
                canvas.width = Math.round(bitmap.width * scale);
                canvas.height = Math.round(bitmap.height * scale);
                canvas.getContext('2d').drawImage(bitmap, 0, 0, canvas.width, canvas.height);

                const outputType = file.type === 'image/png' ? 'image/png' : 'image/jpeg';
                const blob = await new Promise(resolve => canvas.toBlob(resolve, outputType, imageQuality));
                if (!blob || blob.size >= file.size)
                    return file;

                const extension = outputType === 'image/png' ? '.png' : '.jpg';
                const name = file.name.replace(/\.[^.]*$/, '') + extension;

                return new File([blob], name, { type: outputType, lastModified: Date.now() });
            } catch {
                return file;
            } finally {
                bitmap.close?.();
            }
        }

        const serverConfig = {
            process: (fieldName, file, metadata, load, error, progress, abort, transfer, options) => {
                const request = new XMLHttpRequest();
                request.open('POST', uploadUrl);

                request.upload.onprogress = (e) => {
                    progress(e.lengthComputable, e.loaded, e.total);
                };

                request.onload = function () {
                    const commonError = '@T("Common.Error")';
                    if (request.status < 200 || request.status >= 300) {
                        error(commonError);
                        return;
                    }

                    const response = JSON.parse(request.responseText);

                    if (response.success) {
                        load(request.responseText);
                        $imageEl.attr("src", response.imageUrl);
                        $modelEl.val(response.pictureId);
                        
                        // Update image link to open full size picture
                        // Get full size URL by removing size parameter from thumbnail URL or constructing it
                        // The thumbnail URL is like: /images/thumbs/0000123_filename.jpg?size=100
                        // Full size URL should be: /images/thumbs/0000123_filename.jpg (without size parameter)
                        let fullSizeUrl = response.imageUrl;
                        if (fullSizeUrl.includes('?size=')) {
                            fullSizeUrl = fullSizeUrl.split('?')[0];
                        } else if (fullSizeUrl.includes('&size=')) {
                            fullSizeUrl = fullSizeUrl.split('&size=')[0];
                        }
                        
                        if ($imageLink.length > 0) {
                            $imageLink.attr("href", fullSizeUrl);
                        } else {
                            // Create link if it doesn't exist
                            const $newLink = $('<a>', {
                                id: '@(clientId)link',
                                href: fullSizeUrl,
                                target: '_blank',
                                title: '@T("Common.ViewFullSize")',
                                style: 'cursor: pointer;'
                            });
                            $imageEl.wrap($newLink);
                        }
                    } else {
                        error(response.message || commonError);
                    }
                };

                downscaleBeforeUpload(file).then((uploadFile) => {
                    const formData = new FormData();
                    formData.append(fieldName, uploadFile, uploadFile.name);
                    request.send(formData);
                });
            },
            remove: (source, load, error) => {
                resetImageToDefault();
                load();
            },
            revert: (uniqueFileId, load, error) => {
                resetImageToDefault();
                load();
            },
        };

        // Create a FilePond instance
        const filePondInstance = FilePond.create(document.querySelector('#@elementId'), {
            credits: false,
            allowMultiple: false,
            maxFiles: 1,
            captureMethod: 'camera',
            allowDownloadByUrl: true,
            server: serverConfig,
            labelFileProcessingError: (err) => err.body,
            acceptedFileTypes: allowedExtensions,
            files: @Json.Serialize(files),
            labelIdle: '@T("Common.FileUploader.DropFiles") / <span class="filepond--label-action">@T("Common.FileUploader.Browse")</span>',
            labelFileProcessing: '@T("Common.FileUploader.Processing")'
        });

        // Add explicit capture hints for mobile browsers that honor input attributes.
        const browserInput = filePondInstance.element.querySelector('input[type="file"]');
        if (browserInput) {
            browserInput.setAttribute('accept', 'image/*');
            browserInput.setAttribute('capture', 'environment');
        }

        // Saving while a picture is still uploading stores PictureId = 0, so the record ends up
        // without an image. Keep the submit buttons locked until every upload on this form settled.
        const $form = $(filePondInstance.element).closest('form');

        function setUploadInProgress(inProgress) {
            if (!$form.length)
                return;

            const uploading = $form.data('uploadingPictures') || new Set();
            if (inProgress)
                uploading.add('@clientId');
            else
                uploading.delete('@clientId');

            $form.data('uploadingPictures', uploading);
            $form.find('button[type="submit"], input[type="submit"]').prop('disabled', uploading.size > 0);
        }

        filePondInstance.on('processfilestart', () => setUploadInProgress(true));
        filePondInstance.on('processfile', () => setUploadInProgress(false));
        filePondInstance.on('processfileabort', () => setUploadInProgress(false));
        filePondInstance.on('processfilerevert', () => setUploadInProgress(false));

        $removeEl.on('click', function (e) {
            resetImageToDefault();
            filePondInstance.removeFiles();
            $(this).hide();
        });
    });
</script>